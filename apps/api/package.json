{
  "name": "@repeatme/api", "private": true, "version": "0.1.0",
  "scripts": {
    "dev": "concurrently -k \"tsc --watch --preserveWatchOutput\" \"node --watch dist/main.js\"",
    "predev": "tsc",
    "build": "tsc",
    "start": "node dist/main.js",
    "db:migrate": "typeorm-ts-node-commonjs migration:run -d src/data-source.ts",
    "db:revert": "typeorm-ts-node-commonjs migration:revert -d src/data-source.ts",
    "test": "vitest run",
    "test:integration": "ts-node test/integration.ts",
    "test:http": "node test/http-smoke.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0", "@nestjs/core": "^11.0.0", "@nestjs/platform-express": "^11.0.0",
    "class-transformer": "^0.5.1", "class-validator": "^0.14.2", "dotenv": "^16.4.7",
    "pg": "^8.13.3", "reflect-metadata": "^0.2.2", "rxjs": "^7.8.2", "typeorm": "^1.1.3"
  },
  "devDependencies": {"@types/node": "^22.13.0", "typescript": "~5.7.3", "ts-node": "^10.9.2", "vitest": "^5.1.0"}
}
